#!/bin/sh
# ============================================================
# git-security-scan pre-commit hook
# 출처: https://github.com/2001056/skills-md
#
# 설치: hooks/install.sh (Linux/Mac) 또는 hooks/install.ps1 (Windows)
# ============================================================

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m'

STAGED_DIFF=$(git diff --staged)
STAGED_FILES=$(git diff --staged --name-only)

# 스테이징된 내용 없으면 통과
if [ -z "$STAGED_DIFF" ]; then
  exit 0
fi

# + 로 시작하는 라인만 추출 (새로 추가된 코드, +++ 헤더 제외)
ADDED=$(echo "$STAGED_DIFF" | grep '^+' | grep -v '^+++')

CRITICAL=0
HIGH=0
REPORT=""

# ──────────────────────────────────────────────────────────────
# 🔴 CRITICAL: API 키 / 자격증명 하드코딩
# ──────────────────────────────────────────────────────────────

# OpenAI API Key
if echo "$ADDED" | grep -qE 'sk-[A-Za-z0-9]{20,}'; then
  REPORT="${REPORT}\n🔴 CRITICAL: OpenAI API Key 하드코딩 감지"
  CRITICAL=$((CRITICAL + 1))
fi

# AWS Access Key ID
if echo "$ADDED" | grep -qE 'AKIA[A-Z0-9]{16}'; then
  REPORT="${REPORT}\n🔴 CRITICAL: AWS Access Key ID 감지"
  CRITICAL=$((CRITICAL + 1))
fi

# GitHub Token
if echo "$ADDED" | grep -qE 'ghp_[A-Za-z0-9]{36}|ghs_[A-Za-z0-9]{36}'; then
  REPORT="${REPORT}\n🔴 CRITICAL: GitHub Token 감지"
  CRITICAL=$((CRITICAL + 1))
fi

# Google API Key
if echo "$ADDED" | grep -qE 'AIza[A-Za-z0-9_-]{35}'; then
  REPORT="${REPORT}\n🔴 CRITICAL: Google API Key 감지"
  CRITICAL=$((CRITICAL + 1))
fi

# Slack Token
if echo "$ADDED" | grep -qE 'xox[bp]-[A-Za-z0-9-]+'; then
  REPORT="${REPORT}\n🔴 CRITICAL: Slack Token 감지"
  CRITICAL=$((CRITICAL + 1))
fi

# SendGrid API Key
if echo "$ADDED" | grep -qE 'SG\.[A-Za-z0-9_-]{22}\.[A-Za-z0-9_-]{43}'; then
  REPORT="${REPORT}\n🔴 CRITICAL: SendGrid API Key 감지"
  CRITICAL=$((CRITICAL + 1))
fi

# Private Key Header
if echo "$ADDED" | grep -qE '-----BEGIN (RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----'; then
  REPORT="${REPORT}\n🔴 CRITICAL: Private Key 하드코딩 감지"
  CRITICAL=$((CRITICAL + 1))
fi

# 비밀번호/시크릿 변수 직접 할당 (플레이스홀더 제외)
PW_MATCH=$(echo "$ADDED" | grep -iE '(password|passwd|secret|api_key|apikey|api-key|auth_token|access_token|secret_key|private_key)[[:space:]]*[=:][[:space:]]*"[^"$\{\}]{4,}"' | grep -viE '(your-|<your|placeholder|change.me|example|xxx|process\.env|os\.environ|\$\{|secrets\.)')
if [ -n "$PW_MATCH" ]; then
  REPORT="${REPORT}\n🔴 CRITICAL: 시크릿 변수 직접 할당 감지"
  CRITICAL=$((CRITICAL + 1))
fi

# AWS Secret Access Key (변수명 패턴)
if echo "$ADDED" | grep -qE 'aws_secret_access_key[[:space:]]*[=:][[:space:]]*[A-Za-z0-9/+]{40}'; then
  REPORT="${REPORT}\n🔴 CRITICAL: AWS Secret Access Key 감지"
  CRITICAL=$((CRITICAL + 1))
fi

# ──────────────────────────────────────────────────────────────
# 🔴 CRITICAL: 민감 파일 스테이징
# ──────────────────────────────────────────────────────────────

SENSITIVE=$(echo "$STAGED_FILES" | grep -iE \
  '(^|/)\.env(\.[a-z]+)?$|\.pem$|\.key$|\.p12$|\.pfx$|\.jks$|\.keystore$|(^|/)id_rsa$|(^|/)id_ed25519$|(^|/)id_ecdsa$|credentials\.json$|service-account.*\.json$|firebase-adminsdk.*\.json$|google-credentials\.json$|gcloud-key.*\.json$|\.secret$|secrets\.ya?ml$|(^|/)vault-token$|(^|/)\.netrc$|\.aws/credentials$')

if [ -n "$SENSITIVE" ]; then
  REPORT="${REPORT}\n🔴 CRITICAL: 민감 파일 스테이징 감지:"
  echo "$SENSITIVE" | while IFS= read -r f; do
    printf "   - %s  →  git reset HEAD %s\n" "$f" "$f" >&2
  done
  CRITICAL=$((CRITICAL + 1))
fi

# ──────────────────────────────────────────────────────────────
# 🟠 HIGH: 위험한 보안 설정
# ──────────────────────────────────────────────────────────────

# 디버그 모드 (프로덕션 파일)
if echo "$ADDED" | grep -qE 'DEBUG[[:space:]]*=[[:space:]]*True|app\.debug[[:space:]]*=[[:space:]]*True|app\.run\(debug=True'; then
  REPORT="${REPORT}\n🟠 HIGH: 디버그 모드 활성화 감지"
  HIGH=$((HIGH + 1))
fi

# SSL 검증 비활성화
if echo "$ADDED" | grep -qE 'rejectUnauthorized[[:space:]]*:[[:space:]]*false|verify[[:space:]]*=[[:space:]]*False'; then
  REPORT="${REPORT}\n🟠 HIGH: SSL 검증 비활성화 감지"
  HIGH=$((HIGH + 1))
fi

# DB URI에 자격증명 포함
if echo "$ADDED" | grep -qE '(mongodb|redis|postgresql|mysql|jdbc)://[^:]+:[^@]{3,}@'; then
  REPORT="${REPORT}\n🟠 HIGH: DB 접속 URI에 자격증명 포함 감지"
  HIGH=$((HIGH + 1))
fi

# ──────────────────────────────────────────────────────────────
# 결과 출력
# ──────────────────────────────────────────────────────────────

if [ $CRITICAL -eq 0 ] && [ $HIGH -eq 0 ]; then
  printf "${GREEN}✅ git-security-scan: 이상 없음 — 커밋 진행${NC}\n"

  # gitleaks 설치돼 있으면 추가 스캔
  if command -v gitleaks > /dev/null 2>&1; then
    gitleaks protect --staged --redact -q
    if [ $? -ne 0 ]; then
      printf "${RED}⛔ gitleaks: 추가 시크릿 감지 — 커밋 차단${NC}\n"
      exit 1
    fi
  fi

  exit 0
fi

# 문제 발견 시 커밋 차단
printf "\n${RED}⛔ git-security-scan: 보안 문제 감지 — 커밋이 차단됩니다${NC}\n"
printf "${RED}────────────────────────────────────────────${NC}\n"
printf "🔴 CRITICAL : %d건\n" "$CRITICAL"
printf "🟠 HIGH     : %d건\n" "$HIGH"
printf "${RED}────────────────────────────────────────────${NC}\n"
printf "$REPORT\n"
printf "\n"
printf "${YELLOW}▶ 해결 후 다시 커밋하세요.${NC}\n"
printf "${CYAN}▶ 더 상세한 AI 분석: git diff --staged 출력을 AI에게 붙여넣고${NC}\n"
printf "${CYAN}  AI_GUIDE_GIT_SECURITY_SCAN.md 또는 /git-security-scan 스킬 사용${NC}\n"
printf "${CYAN}  https://github.com/2001056/skills-md${NC}\n\n"

exit 1
